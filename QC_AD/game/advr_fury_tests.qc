void() ADVR_TestFury = {
    local entity player,foe,p,shot,target;local float count,oldframe,i,oldmult,left,right,center;local vector at;
    player=self;oldframe=frametime;oldmult=cvar("vr_enemy_drops_chance_mult");
    cvar_set("vr_enemy_drops_chance_mult","1");
    ADVR_Assert(ADVR_FuryCross('0 -12 0','0 12 30','0 12 0','0 -12 30'),"crossed blades accepted");
    ADVR_Assert(!ADVR_FuryCross('0 -12 0','0 -12 30','0 12 0','0 12 30'),"parallel blades rejected");
    ADVR_Assert(!ADVR_FuryCross('0 -12 0','0 12 30','10 12 0','10 -12 30'),"separated blades rejected");
    foe=spawn();foe.classtype=CT_MONDFURY;setorigin(foe,self.origin+'0 0 16');
    self=foe;ADVR_EnemyDrop();ADVR_EnemyDrop();self=player;
    p=find(world,classname,"advr_dropped_weapon");
    while(p){if(p.owner==foe && ADVR_IsFury(p.weaponinst))count=count+1;p=find(p,classname,"advr_dropped_weapon");}
    ADVR_Assert(count==2,"Fury drops exactly two swords once");
    ADVR_Reset();self.advr_initialized=1;self.health=100;
    self.advr_main=ADVR_Record(IT_AXE);self.advr_main.advr_kind=ADVR_FURY1;
    self.advr_off=ADVR_Record(IT_AXE);self.advr_off.advr_kind=ADVR_FURY2;ADVR_Sync();
    ADVR_Assert(ADVR_CanParry(self.advr_main) && ADVR_CanParry(self.advr_off),"both Fury swords can parry");
    ADVR_SaveParms();ADVR_Reset();ADVR_LoadParms();
    ADVR_Assert(self.advr_main.advr_kind==ADVR_FURY1 && self.advr_off.advr_kind==ADVR_FURY2,"map parms preserve both variants");
    at=self.origin+'0 0 24';self.headpos=at;self.v_angle='0 0 0';
    self.handpos=at+'24 -12 -8';self.muzzlepos=at+'24 12 22';
    self.offhandpos=at+'24 12 -8';self.offmuzzlepos=at+'24 -12 22';
    frametime=0.05;
    for(i=0;i<8;i=i+1)ADVR_FuryFrame();
    ADVR_Assert(self.advr_fury_charge>0 && self.advr_fury_glow,"cross builds visible charge");
    ADVR_Assert(self.advr_fury_guide && self.advr_fury_guide.alpha==0.22,"faint guide appears during charge");
    ADVR_Assert(vlen(self.advr_fury_guide.origin-(advr_fury_cross+'24 0 0'))<0.01,"guide matches center launch ray");
    target=spawn();target.solid=SOLID_BBOX;setsize(target,'-4 -40 -40','4 40 40');setorigin(target,advr_fury_cross+'60 0 0');
    ADVR_FuryGuide(advr_fury_cross+'8 0 0','1 0 0');
    ADVR_Assert(self.advr_fury_guide.modelindex && !self.advr_fury_guide.chain.chain.modelindex,"guide stops at blocker");remove(target);
    ADVR_Sync();ADVR_Assert(self.weaponframe==2 && self.weaponframe2==2,"both blades show partial yellow charge");
    self.offmuzzlepos=self.offhandpos+'0 0 30';ADVR_FuryFrame();
    ADVR_Assert(!self.advr_fury_charge && !self.advr_fury_glow && !self.advr_fury_guide,"uncross cancels charge and glow");
    ADVR_Sync();ADVR_Assert(self.weaponframe==0 && self.weaponframe2==0,"uncross restores normal blade skins");
    self.offmuzzlepos=at+'24 -12 22';
    for(i=0;i<22;i=i+1)ADVR_FuryFrame();
    ADVR_Assert(self.advr_fury_latched && self.advr_fury_cooldown>time,"full charge fires and latches");
    ADVR_Assert(!self.advr_fury_guide,"firing removes guide");
    shot=newmis;count=0;
    p=world;
    while((p=nextent(p)))if(p.owner==self && p.classtype==CT_PROJ_FURY1) {
        count=count+1;
        ADVR_Assert(fabs(vlen(p.velocity)-750)<1 && fabs(p.velocity_z)<1,"volley keeps native speed and horizontal cone");
        if(p.velocity_y>50)left=left+1;
        else if(p.velocity_y<-50)right=right+1;
        else center=center+1;
    }
    ADVR_Assert(count==3 && left==1 && right==1 && center==1,"exactly three projectiles fan left center right");
    ADVR_Assert(fabs(self.advr_fury_cooldown-time-5)<0.01,"volley has five second cooldown");
    ADVR_Assert(shot.owner==self && shot.classtype==CT_PROJ_FURY1 && shot.model==MODEL_PROJ_FURY1,"native red explosive projectile credits player");
    for(i=0;i<30;i=i+1)ADVR_FuryFrame();
    ADVR_Assert(newmis==shot,"held X does not repeat fire");
    target=spawn();target.classname="advr_test_target";target.classtype=CT_TARGETDUMMY;
    target.solid=SOLID_BBOX;target.takedamage=DAMAGE_YES;target.health=1000;
    setsize(target,'-4 -4 -4','4 4 4');setorigin(target,shot.origin+'12 0 0');
    self=shot;other=world;Touch_Missile();self=player;
    ADVR_Assert(target.health<1000,"Fury projectile explodes with radius damage");remove(target);
    self.offmuzzlepos=self.offhandpos+'0 0 30';ADVR_FuryFrame();
    ADVR_Assert(!self.advr_fury_latched,"uncross rearms after firing");
    self.offmuzzlepos=at+'24 -12 22';newmis=world;
    for(i=0;i<22;i=i+1)ADVR_FuryFrame();
    ADVR_Assert(!newmis && !self.advr_fury_charge,"recross cannot bypass cooldown");
    self.advr_fury_cooldown=time-0.01;
    for(i=0;i<22;i=i+1)ADVR_FuryFrame();
    ADVR_Assert(newmis && self.advr_fury_latched,"attack becomes available after cooldown");
    frametime=oldframe;cvar_set("vr_enemy_drops_chance_mult",ftos(oldmult));
    bprint("ADVR FURY PASS: paired drops, identity, X charge/cancel/latch, native projectile and splash\n");
};
