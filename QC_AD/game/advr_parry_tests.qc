// Destructive developer fixture: isolated test runtime only.
void() ADVR_TestParry = {
    local entity actor,foe,r,missile,prop;
    local float hp,spent,count,dt,i;
    actor=self;ADVR_Reset();self.advr_initialized=1;
    self.flags=FL_CLIENT;self.health=1000;self.armorvalue=0;self.armortype=0;
    self.invincible_finished=0;self.moditems=0;self.items=IT_AXE|IT_SHOTGUN;self.ammo_shells=20;
    self.vrbits0=16384;self.headpos=self.origin+'0 0 32';
    self.handpos=self.origin+'16 -12 24';self.muzzlepos=self.origin+'16 20 24';self.handrot='0 90 0';
    self.advr_main=ADVR_Record(IT_AXE);self.advr_main.advr_kind=ADVR_SWORD;ADVR_Sync();
    cvar_set("vr_parry","1");cvar_set("vr_parry_stamina","1");cvar_set("vr_parry_stamina_max","100");
    cvar_set("vr_parry_stamina_cost","30");cvar_set("vr_parry_stamina_cost_2h","12");
    cvar_set("vr_parry_stamina_delay","2");cvar_set("vr_parry_stamina_regen","25");
    cvar_set("vr_parry_reduction","0.75");cvar_set("vr_parry_cooldown","0.4");
    cvar_set("vr_parry_cooldown_attack","1");cvar_set("vr_parry_push_enemy","0");cvar_set("vr_parry_push_player","0");
    cvar_set("vr_deflect","1");cvar_set("vr_deflect_window","0.2");cvar_set("vr_deflect_radius","14");
    foe=spawn();foe.classname="monster_knight";foe.flags=FL_MONSTER;foe.health=100;
    foe.takedamage=DAMAGE_AIM;foe.solid=SOLID_SLIDEBOX;foe.movetype=MOVETYPE_STEP;
    setsize(foe,'-16 -16 -24','16 16 40');setorigin(foe,self.origin+'60 0 0');
    self.advr_main.advr_weapon=IT_SHOTGUN;self.advr_main.advr_kind=0;
    hp=self.health;ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(hp-self.health==40 && self.vr_stamina_used==0,"gun cannot reduce a melee hit or spend parry stamina");
    self.advr_main.advr_weapon=IT_AXE;self.advr_main.advr_kind=ADVR_SWORD;
    hp=self.health;ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(hp-self.health==10,"weapon guard reduces native melee damage by 75 percent");
    ADVR_Assert(self.vr_stamina_used==30,"one-handed parry spends 30");
    foe.enemy=self;foe.angles='0 180 0';foe.advr_parry_last=0;count=advr_parries;
    self=foe;ai_melee();self=actor;
    ADVR_Assert(advr_parries==count+1,"native AD melee helper enters the guard adapter");
    self.vr_stamina_used=30;
    hp=self.health;ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(hp-self.health==10 && self.vr_stamina_used==30,"rapid chained hits block without double charging");
    foe.advr_melee_begun=time-0.6;foe.advr_parry_attack=foe.advr_melee_begun;foe.advr_parry_last=time-0.5;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(self.vr_stamina_used==30,"same-attack cooldown survives gaps between claws");
    foe.advr_parry_last=0;self.vrbits0=16384|32;self.vr_stamina_used=0;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(self.vr_stamina_used==12,"two-handed grip spends 12");
    self.vrbits0=16384;foe.advr_parry_last=0;self.vr_stamina_used=90;r=self.advr_main;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(self.vr_stamina_used==100 && !self.advr_main,"last parry disarms at exhaustion");
    prop=find(world,classname,"advr_dropped_weapon");
    while(prop && prop.weaponinst!=r)prop=find(prop,classname,"advr_dropped_weapon");
    ADVR_Assert(prop!=world && r.advr_kind==ADVR_SWORD,"disarmed weapon retains its sword identity");
    ADVR_Catch(prop,1);hp=self.health;foe.advr_parry_last=0;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(hp-self.health==40,"re-grabbing cannot parry with empty stamina");
    self.vr_stamina_time=time;spent=self.vr_stamina_used;ADVR_ParryFrame();
    ADVR_Assert(self.vr_stamina_used==spent,"recovery waits two seconds");
    self.vr_stamina_time=time-3;ADVR_ParryFrame();
    ADVR_Assert(self.vr_stamina_used<spent && (self.vr_melee_hud & 512),"stamina regenerates and gadget reports recovery");
    self.vr_stamina_used=0;
    // Wrong pose, no weapon, disabled feature, untracked player and ordinary
    // T_Damage (lightning/environment) must all retain native full damage.
    self.muzzlepos=self.handpos+'30 0 0';hp=self.health;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);ADVR_Assert(hp-self.health==40,"aiming at attacker is not a guard");
    self.muzzlepos=self.origin+'16 20 24';self.advr_main=world;hp=self.health;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);ADVR_Assert(hp-self.health==40,"empty hand is not a weapon parry");
    self.advr_main=r;cvar_set("vr_parry","0");hp=self.health;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);ADVR_Assert(hp-self.health==40,"parry switch disables guards");
    cvar_set("vr_parry","1");self.vrbits0=0;hp=self.health;
    ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);ADVR_Assert(hp-self.health==40,"desktop player remains unchanged");
    self.vrbits0=16384;hp=self.health;T_Damage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(hp-self.health==40,"beam damage never enters melee guard");
    self.advr_main=world;self.advr_off=r;self.offhandpos=self.handpos;self.offmuzzlepos=self.muzzlepos;
    foe.advr_parry_last=0;hp=self.health;ADVR_MeleeDamage(self,foe,foe,40,DAMARMOR);
    ADVR_Assert(hp-self.health==10,"off-hand guard works");self.advr_main=r;self.advr_off=world;
    ADVR_Assert(ADVR_SegmentDistance('0 0 0','10 0 0','5 -5 0','5 5 0')<0.01,"crossing segment collision");
    ADVR_Assert(fabs(ADVR_SegmentDistance('0 0 0','10 0 0','0 3 0','10 3 0')-3)<0.01,"parallel segment collision");
    // Populate the history through the same tracked-motion function as gameplay.
    self.handvel='3 0 0';self.vr_stamina_used=0;
    r.advr_guard_player=self;r.advr_guard_hand=1;r.advr_guard_time=time-0.02;
    r.advr_guard_near=self.handpos-'0 5 0';r.advr_guard_far=self.muzzlepos;
    ADVR_TrackBat(1);count=0;for(i=0;i<8;i=i+1)if(r.advr_bat_time[i]==time)count=count+1;
    ADVR_Assert(count>0,"moving weapon produces batting history");
    i=r.advr_bat_index;r.advr_bat_slot_time=time-0.03;r.advr_guard_time=time-0.01;
    ADVR_TrackBat(1);ADVR_Assert(r.advr_bat_index!=i && r.advr_bat_time[i]>0,"batting history retains earlier swing segments");
    missile=spawn();missile.owner=foe;missile.touch=Touch_Projectile;missile.movetype=MOVETYPE_FLYMISSILE;
    missile.solid=SOLID_BBOX;missile.velocity='-600 0 0';missile.classtype=CT_PROJ_WIZ;
    setsize(missile,'0 0 0','0 0 0');setorigin(missile,self.origin+'18 0 24');
    r.advr_weapon=IT_SHOTGUN;r.advr_kind=0;count=advr_deflections;
    ADVR_Assert(!ADVR_BatProjectile(missile,1) && advr_deflections==count && self.vr_stamina_used==0,"gun with stale swing history cannot deflect or spend stamina");
    r.advr_weapon=IT_AXE;r.advr_kind=ADVR_SWORD;
    ADVR_Assert(ADVR_BatProjectile(missile,1),"swept swing intercepts incoming projectile");
    ADVR_Assert(missile.owner==self && missile.enemy==foe && missile.velocity_x>0,"projectile returns with player damage credit");
    missile.attack_lifetime=time+10;self=missile;Think_Projectile();self=actor;
    ADVR_Assert(missile.velocity_x>0,"native projectile thinker keeps the reflected trajectory");
    ADVR_Assert(self.vr_stamina_used==30,"batting uses the shared stamina pool");
    ADVR_Assert(!ADVR_BatProjectile(missile,1),"reflected projectile cannot be batted repeatedly");
    missile.advr_deflected=0;missile.owner=self;ADVR_Assert(!ADVR_CanDeflect(missile),"own shots excluded");
    missile.owner=foe;missile.touch=Touch_HomingMissile;missile.oldenemy=foe;missile.enemy=self;
    missile.velocity='-600 0 0';
    count=advr_deflections;trace_fraction=0.375;trace_endpos='7 8 9';
    self=missile;other=actor;Touch_HomingMissile();self=actor;other=world;
    ADVR_Assert(advr_deflections==count+1,"native projectile touch intercepts fast shots");
    ADVR_Assert(trace_fraction==0.375 && trace_endpos=='7 8 9',"touch adapter preserves native impact trace");
    ADVR_Assert(missile.oldenemy==self && missile.enemy==foe,"homing damage owner and target transferred");
    self=missile;Steer_HomingMissile();self=actor;
    ADVR_Assert(missile.owner==actor && missile.velocity_x>0,"homing update preserves reflected ownership");
    ADVR_Assert(self.vr_stamina_used==30,"same batting effort handles a volley once");
    missile.advr_deflected=0;missile.owner=foe;missile.touch=Touch_Grenade;
    missile.movetype=MOVETYPE_BOUNCE;missile.nextthink=time+2;missile.think=Explode_Grenade;missile.velocity='-500 0 0';
    dt=missile.nextthink;ADVR_Assert(ADVR_BatProjectile(missile,1),"grenade can be batted");
    ADVR_Assert(missile.nextthink==dt && missile.think==Explode_Grenade,"batting preserves the grenade fuse");
    missile.touch=Touch_PlasmaProjectile;missile.advr_deflected=0;missile.owner=foe;
    ADVR_Assert(ADVR_CanDeflect(missile),"plasma projectiles are supported");
    missile.touch=Touch_Bullet;ADVR_Assert(ADVR_CanDeflect(missile),"physical shotgun pellets are supported");
    missile.touch=Touch_Missile;ADVR_Assert(ADVR_CanDeflect(missile),"rockets and fireballs are supported");
    missile.classtype=CT_PROJ_MEGG;ADVR_Assert(!ADVR_CanDeflect(missile),"monster eggs are not ordinary projectiles");
    missile.classtype=CT_PROJ_WIZ;
    missile.advr_deflected=0;missile.oldenemy=foe;missile.owner=foe;missile.velocity='-600 0 0';
    for(i=0;i<8;i=i+1)r.advr_bat_time[i]=time-1;
    ADVR_Assert(!ADVR_BatProjectile(missile,1),"expired swing cannot deflect");
    r.advr_bat_time[0]=time;r.advr_bat_near[0]=r.advr_guard_near;r.advr_bat_far[0]=r.advr_guard_far;r.advr_bat_vel[0]='100 0 0';
    self.vr_stamina_used=100;ADVR_Assert(!ADVR_BatProjectile(missile,1),"exhausted swing cannot deflect");
    self.vr_stamina_used=0;cvar_set("vr_deflect","0");
    ADVR_Assert(!ADVR_BatProjectile(missile,1),"deflect switch respected");cvar_set("vr_deflect","1");
    remove(missile);remove(foe);self.flags=self.flags|FL_GODMODE;self.handvel='0 0 0';ADVR_Sync();
    bprint("ADVR PARRY PASS: guards, cooldowns, stamina, disarm, regeneration, off-hand, exclusions, swept batting and homing\n");
};

entity advr_saved_missile,advr_saved_thrower;
void() ADVR_TestParrySave = {
    self.vr_stamina_used=45;self.vr_stamina_time=time+600;
    advr_saved_thrower=spawn();advr_saved_thrower.health=100;advr_saved_thrower.flags=FL_MONSTER;
    advr_saved_missile=spawn();advr_saved_missile.classname="advr_saved_projectile";
    advr_saved_missile.owner=self;advr_saved_missile.oldenemy=self;
    advr_saved_missile.enemy=advr_saved_thrower;advr_saved_missile.advr_deflected=1;
    advr_saved_missile.advr_projectile_payload='10 20 30';advr_saved_missile.finalangle='1 0 0';
    advr_saved_missile.touch=Touch_HomingMissile;
};
void() ADVR_TestParryLoad = {
    ADVR_Assert(self.vr_stamina_used==45,"spent stamina survives save/load");
    ADVR_Assert(advr_saved_missile.owner==self && advr_saved_missile.oldenemy==self &&
       advr_saved_missile.enemy==advr_saved_thrower && advr_saved_missile.advr_deflected,"reflected ownership survives save/load");
    ADVR_Assert(advr_saved_missile.touch==Touch_HomingMissile && advr_saved_missile.advr_projectile_payload=='10 20 30',"projectile callback and damage payload survive save/load");
    remove(advr_saved_missile);remove(advr_saved_thrower);self.vr_stamina_time=time;
    bprint("ADVR PARRY SAVE PASS: stamina and reflected projectile preserved\n");
};
