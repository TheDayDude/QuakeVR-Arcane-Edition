void() ADVR_TestVoid = {
    local entity actor,v,r,shot,n,job,near,far;local float i,oldframe,hp,total;local vector at;
    actor=self;oldframe=frametime;frametime=0.05;
    ADVR_TestMagicView();self.advr_known=239;r=ADVR_Record(IT_AXE);r.advr_kind=ADVR_TOME;ADVR_TomePickup(self,r);
    ADVR_Assert(self.advr_known==255 && self.advr_spell==4,"tome learns void");remove(r);
    self.advr_favorites[4]=5;ADVR_SaveParms();ADVR_Reset();ADVR_LoadParms();
    ADVR_Assert(self.advr_spell==4 && self.weaponframe2==4 && self.advr_favorites[4]==5,"void selection and shortcut persist");
    self.vrbits0=16384;self.handpos=ADVR_Head(self)+'24 0 -8';self.handvel=self.offhandvel='0 0 0';
    self.handrot=self.offhandrot='0 0 0';self.mainhand_hotspot=self.offhand_hotspot=0;
    self.advr_magic_sticks=2;
    for(i=0;i<15;i=i+1)ADVR_MagicFrame();
    ADVR_Assert(self.advr_magic_ready && self.advr_magic_fx.model=="progs/advr_void_charge.mdl","purple orb charges");
    hp=self.mana;self.handvel='1 0 0';self.advr_magic_sticks=0;ADVR_MagicFrame();shot=newmis;
    ADVR_Assert(shot.advr_voidorb && shot.model==MODEL_PROJ_SHAL && self.mana==hp-1,"void casts vore orb for one mana");
    at=self.handpos;
    near=spawn();near.classname="void_near";near.flags=FL_MONSTER;near.health=1000;near.takedamage=DAMAGE_YES;
    near.solid=SOLID_BBOX;setsize(near,'-4 -4 -4','4 4 4');setorigin(near,at+'80 10 0');
    far=spawn();far.flags=FL_MONSTER;far.health=1000;far.takedamage=DAMAGE_YES;far.solid=SOLID_BBOX;
    setsize(far,'-4 -4 -4','4 4 4');setorigin(far,at+'120 -10 0');
    ADVR_Assert(ADVR_VoidTarget(at,'1 0 0',actor)==near,"nearest visible monster in aim cone selected");
    ADVR_Assert(ADVR_VoidTarget(at,'-1 0 0',actor)!=near,"behind-hand target rejected");
    shot.enemy=near;self=shot;ADVR_VoidThink();self=actor;
    ADVR_Assert(shot.velocity_y>0 && fabs(vlen(shot.velocity)-500)<1,"orb steers toward target");
    setorigin(far,at+'80 60 0');setorigin(shot,near.origin+'-6 0 0');shot.advr_magic_damage=1;
    near.enemy=far.enemy=actor;near.switchattacker=far.switchattacker=actor;near.switchtimer=far.switchtimer=time+100;
    self=shot;other=near;ADVR_VoidTouch();self=actor;
    ADVR_Assert(near.health==960 && far.health<1000,"void explosion damages direct and nearby targets");remove(near);remove(far);
    v=ADVR_HammerTestFoe();v.max_health=v.health=1000;v.nextthink=time+300;
    ADVR_VoidRoll(v,actor,0.5);ADVR_Assert(!v.advr_void_pending,"ordinary roll does not transform");
    v.advr_void_rolltime=0;ADVR_VoidRoll(v,actor,0.049);job=v.advr_void_pending;
    ADVR_Assert(job && job.nextthink>time,"five percent roll defers mutation until after damage");
    v.advr_void_pending=world;remove(job);total=total_monsters;
    setorigin(v,actor.origin+'0 80 64');
    n=ADVR_VoidTransform(v,actor,1);
    bprint("VOID MUTATION probe ");bprint(ftos(n!=world));if(n){bprint(n.classname);bprint(ftos(n.classtype));}bprint("\n");
    ADVR_Assert(n && n.classtype==CT_MONVORELING && n.think && n.nextthink>time,"transformation creates a different native monster");
    ADVR_Assert(total_monsters==total && n.enemy==actor,"transformation preserves count and aggression");
    n.bossflag=1;ADVR_Assert(!ADVR_VoidEligible(n),"bosses retain scripted form");n.bossflag=0;
    n.target="test_event";ADVR_Assert(!ADVR_VoidEligible(n),"scripted enemies retain event identity");n.target="";
    n.nextthink=time+300;n.health=1000;n.armorvalue=0;n.armortype=0;n.takedamage=DAMAGE_YES;n.invincible_finished=0;n.switchtimer=time+100;n.switchattacker=actor;
    r=ADVR_Record(IT_SHOTGUN);r.advr_enchant_type=5;r.advr_enchant_until=time+30;r.advr_enchant_scale=1;
    ADVR_EnchantRestore(r,ADVR_EnchantPack(r));ADVR_Assert(r.advr_enchant_type==5,"void enchant map packing");
    advr_attack_actor=actor;advr_attack_record=r;n.advr_void_rolltime=time+100;
    T_Damage(n,actor,actor,40,NOARMOR);ADVR_Assert(n.health==960,"ranged void adds no direct damage bonus");
    r.advr_weapon=IT_AXE;r.advr_kind=ADVR_SWORD;hp=n.health;
    T_Damage(n,actor,actor,40,NOARMOR);ADVR_Assert(n.health==hp-43,"melee void adds 7.5 percent damage");
    r.advr_enchant_scale=1.2;ADVR_Assert(fabs(ADVR_EnchantDamage(n,actor,actor,40)-43.6)<0.01,"melee void bonus scales with runes");
    r.advr_enchant_scale=1;r.advr_weapon=IT_SHOTGUN;r.advr_kind=0;
    n.classgroup=CG_STONE;r.advr_enchant_type=3;hp=n.health;T_Damage(n,actor,actor,40,NOARMOR);
    ADVR_Assert(n.health==hp-41 && n.advr_frost_until==time+4,"stone halves frost bonus and duration");
    n.classtype=CT_MONMINOTAUR;r.advr_enchant_type=2;hp=n.health;T_Damage(n,actor,actor,40,NOARMOR);
    ADVR_Assert(n.health==hp-41 && ADVR_LightningResistance(n)==0.5,"minotaur halves lightning bonus");
    advr_attack_actor=world;advr_attack_record=world;remove(n);
    self.advr_main=r;self.advr_spell=4;self.handvel='0 0 0';self.advr_magic_sticks=2;
    for(i=0;i<65;i=i+1)ADVR_MagicFrame();
    ADVR_Assert(r.advr_enchant_type==5,"stick hold applies void enchant");self.advr_magic_sticks=0;ADVR_MagicFrame();
    frametime=oldframe;ADVR_Sync();
    bprint("ADVR VOID PASS: casting, aim selection, homing, explosion, mutation, resistance and enchantment\n");
};
